# >>>> INPUT FILE FOR MC-GPU v1.3 >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
# 
#   Input file to reproduce XVI fantom images
#
#
 
#[SECTION SIMULATION CONFIG v.2009-05-12]
1E10                                              #  TOTAL NUMBER OF HISTORIES, OR SIMULATION TIME IN SECONDS IF VALUE < 100000
32189                                             #  RANDOM SEED (ranecu PRNG) # test comment
0                                                 #  GPU NUMBER TO USE WHEN MPI IS NOT USED, OR TO BE AVOIDED IN MPI RUNS
512                                               #  GPU THREADS PER CUDA BLOCK (multiple of 32)
299                                               #  SIMULATED HISTORIES PER GPU THREAD
 
#[SECTION SOURCE v.2011-07-12]
../../../machines/spectra/120kVp_XVI.spc                                                         #  X-RAY ENERGY SPECTRUM FILE
25.520 -72.484 14.500                             #  SOURCE POSITION
0.0 1.0 0.0                                       #  SOURCE DIRECTION COSINES: U V W
-1 -1                                             #  POLAR AND AZIMUTHAL APERTURES FOR THE FAN BEAM [degrees] (input negative to cover the whole detector)
 
#[SECTION IMAGE DETECTOR v.2009-12-02]
../../../output/XVI/rebin4_pancreas_rev/Pancreas-CT-CB_009/Pancreas-CT-CB_009                        #  OUTPUT IMAGE FILE NAME
208    128                                        #  NUMBER OF PIXELS IN THE IMAGE: Nx Nz
66.56   40.96                                     #  IMAGE SIZE (width, height): Dx Dz [cm]
153.6                                             #  SOURCE-TO-DETECTOR DISTANCE (detector set in front of the source, perpendicular to the initial direction)
0 0                                               #  DETECTOR POSITION X Y (U V) [cm] (should actually vary with angle, working on this)
 
#[SECTION CT SCAN TRAJECTORY v.2011-10-25]
720                                               #  NUMBER OF PROJECTIONS (beam must be perpendicular to Z axis, set to 1 for a single projection)
0.5                                               #  ANGLE BETWEEN PROJECTIONS [degrees] (360/num_projections for full CT)
0.0 5000.0                                        #  ANGLES OF INTEREST (projections outside the input interval will be skipped)
100.0                                             #  SOURCE-TO-ROTATION AXIS DISTANCE (rotation radius, axis parallel to Z)
0.0                                               #  VERTICAL TRANSLATION BETWEEN PROJECTIONS (HELICAL SCAN)
0 0                                               #  NOT USED                # Isocenter position

#[SECTION DOSE DEPOSITION v.2012-12-12]
NO                                                #  TALLY MATERIAL DOSE? [YES/NO] (electrons not transported, x-ray energy locally deposited at interaction)
NO                                                #  TALLY 3D VOXEL DOSE? [YES/NO] (dose measured separately for each voxel)
./dose/dose.dat #  OUTPUT VOXEL DOSE FILE NAME
1  512                                            #  VOXEL DOSE ROI: X-index min max (first voxel has index 1)
1  512                                            #  VOXEL DOSE ROI: Y-index min max
1  200                                            #  VOXEL DOSE ROI: Z-index min max
  
#[SECTION VOXELIZED GEOMETRY FILE v.2009-11-30]
../../../phantoms/Pancreas-CT-CB//Pancreas-CT-CB_009/ph.vox                                  #  VOXEL GEOMETRY FILE (penEasy 2008 format; .gz accepted)
 
#[SECTION MATERIAL FILE LIST v.2009-11-30]
../../..//mcgpu_materials/air.mcgpu                                                                #  1st MATERIAL FILE (.gz accepted)
../../..//mcgpu_materials/muscle.mcgpu                                                             #  2nd MATERIAL FILE
../../..//mcgpu_materials/soft_tissue.mcgpu                                                        #  3rd MATERIAL FILE
../../..//mcgpu_materials/bone.mcgpu                                                               #  4th MATERIAL FILE
../../..//mcgpu_materials/cartilage.mcgpu                                                          #  5th MATERIAL FILE
../../..//mcgpu_materials/adipose.mcgpu                                                            #  6th MATERIAL FILE
../../..//mcgpu_materials/blood.mcgpu                                                              #  7th MATERIAL FILE
../../..//mcgpu_materials/skin.mcgpu                                                               #  8th MATERIAL FILE
../../..//mcgpu_materials/lung.mcgpu                                                               #  9th MATERIAL FILE
../../..//mcgpu_materials/gland_others.mcgpu                                                       #  10th MATERIAL FILE
../../..//mcgpu_materials/brain.mcgpu                                                              #  11th MATERIAL FILE
../../..//mcgpu_materials/red_marrow.mcgpu                                                         #  12th MATERIAL FILE
../../..//mcgpu_materials/liver.mcgpu                                                              #  13th MATERIAL FILE
../../..//mcgpu_materials/stomach_intestine.mcgpu                                                  #  14th MATERIAL FILE
